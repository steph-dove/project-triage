// DATABASE_URL relative paths resolve against this directory, not the repo root.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Intake {
  id          String   @id @default(cuid())
  title       String
  description String
  budgetRange String
  timeline    String
  industry    String
  status      String   @default("NEW") // NEW | IN_REVIEW | ACCEPTED | DECLINED
  createdAt   DateTime @default(now())

  enrichment Enrichment?
  tags       Tag[]
  events     Event[]

  @@index([createdAt])
  @@index([status])
}

// Job record and AI result in one row, so queue state cannot drift from domain state.
model Enrichment {
  id       String @id @default(cuid())
  intakeId String @unique
  intake   Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  state    String  @default("PENDING") // PENDING | PROCESSING | READY | FAILED
  summary  String?
  risks    String? // JSON array
  source   String? // LLM | FALLBACK
  model    String?
  attempts Int     @default(0)
  error    String?

  // queue coordination
  nextAttemptAt  DateTime  @default(now())
  lockedBy       String? // worker id, for debugging
  lockToken      String? // fencing token — stale workers cannot write
  leaseExpiresAt DateTime?

  // instrumentation for reviewing prompt quality afterwards
  promptVersion String?
  rawResponse   String?
  latencyMs     Int?
  tokensIn      Int?
  tokensOut     Int?

  updatedAt DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([state, leaseExpiresAt])
  // The dashboard's latency sample: newest finished results first.
  @@index([state, source, updatedAt])
}

// Rows rather than a JSON blob so the dashboard can groupBy.
model Tag {
  id       String @id @default(cuid())
  intakeId String
  intake   Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  label    String

  @@index([label])
  // The export loads tags for 500 intakes per batch.
  @@index([intakeId])
}

// Append-only. `seq` is also the SSE resume cursor for Last-Event-ID.
model Event {
  seq      Int    @id @default(autoincrement())
  intakeId String
  intake   Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  type      String // QUEUED | CLAIMED | CALLING_MODEL | PARTIAL | VALIDATING
  //        | READY | FAILED | FALLBACK | RETRY_SCHEDULED | STATUS_CHANGED
  payload   String? // JSON
  createdAt DateTime @default(now())

  @@index([intakeId, seq])
  @@index([seq])
  // The dashboard's retry count. PARTIAL makes this the fastest-growing table, so no scans.
  @@index([type, createdAt])
}

// Presence, not coordination: nothing reads this to decide who runs a job. Job locks alone
// cannot show an idle worker, and the dashboard counts those too.
model Worker {
  id          String   @id
  concurrency Int
  startedAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
