# Copy to .env and fill in. Nothing here is a real secret.

# SQLite. Relative paths resolve against prisma/, NOT the repo root — `../data` is <repo>/data.
# In Docker this is set to an absolute path (file:/app/data/dev.db) by compose.
DATABASE_URL="file:../data/dev.db"

# Required when AI_PROVIDER=openai. Leave blank to run on the mock provider.
OPENAI_API_KEY=""

# openai | mock. The mock returns a canned result after a short delay — deterministic tests,
# no API spend.
AI_PROVIDER="openai"

# Set to 1 to make the AI client throw, for demonstrating the error and fallback paths.
FORCE_AI_FAILURE=""

# Worker tuning. Effective parallelism is WORKER_REPLICAS x WORKER_CONCURRENCY.
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
WORKER_LEASE_MS=60000
WORKER_HEARTBEAT_MS=15000
WORKER_MAX_ATTEMPTS=3
WORKER_REPLICAS=2

# Run a worker inside the Next.js process instead of a separate one. Local convenience only.
WORKER_IN_PROCESS="false"
